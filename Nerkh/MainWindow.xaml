<Window x:Class="Nerkh.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="نرخو — بازار زنده ایران" Height="840" Width="1320" MinHeight="720" MinWidth="1100" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResizeWithGrip" Loaded="Window_Loaded" Closed="Window_Closed">
 <Border Background="{StaticResource PageBrush}" CornerRadius="18" BorderBrush="#293448" BorderThickness="1">
  <Grid><Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" CornerRadius="18,18,0,0" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Grid Margin="16,0,8,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="28" Height="28" CornerRadius="9" Background="{StaticResource AccentBrush}"><TextBlock Text="نـ" FontWeight="Bold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="نرخو" FontWeight="Bold" FontSize="15" Margin="10,0,0,0" VerticalAlignment="Center"/><Border Width="1" Height="14" Background="{StaticResource LineBrush}" Margin="12,0"/><TextBlock Text="بازار زنده ایران" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Style="{StaticResource IconButton}" Content="—" Click="Minimize_Click"/><Button Style="{StaticResource IconButton}" Content="□" Click="Maximize_Click"/><Button Style="{StaticResource IconButton}" Content="×" FontSize="20" Click="Close_Click"/></StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Background="{StaticResource SidebarBrush}" CornerRadius="0,0,0,18" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,1,0">
     <Grid Margin="12,20,12,14"><Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="فضای کاری" Foreground="{StaticResource SubtleBrush}" FontSize="10" FontWeight="Bold" Margin="14,0,0,8"/>
       <Button x:Name="DashboardNav" Style="{StaticResource NavButton}" Background="{StaticResource AccentSoftBrush}" Foreground="White" Click="DashboardNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" Foreground="{StaticResource AccentBrush}" FontSize="19" Width="30"/><TextBlock Text="داشبورد" VerticalAlignment="Center"/></StackPanel></Button>
       <Button x:Name="MarketsNav" Style="{StaticResource NavButton}" Click="MarketsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="≡" FontSize="19" Width="30"/><TextBlock Text="همه بازارها" VerticalAlignment="Center"/></StackPanel></Button>
       <TextBlock Text="واحد نمایش" Foreground="{StaticResource SubtleBrush}" FontSize="10" FontWeight="Bold" Margin="14,28,0,8"/>
       <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="4"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="TomanButton" Content="تومان" Background="{StaticResource AccentSoftBrush}" Height="34" Click="Toman_Click"/><Button x:Name="RialButton" Grid.Column="1" Content="ریال" Foreground="{StaticResource MutedBrush}" Height="34" Click="Rial_Click"/></Grid></Border>
      </StackPanel>
      <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="13" Padding="13"><StackPanel><StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#F3C969" Margin="0,0,8,0"/><TextBlock x:Name="ConnectionText" Text="در حال اتصال…" FontSize="11"/></StackPanel><TextBlock x:Name="UpdatedText" Text="—" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="16,5,0,0"/></StackPanel></Border>
     </Grid>
    </Border>
    <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="28,23,28,16"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock x:Name="PageTitle" Text="نبض بازار" FontSize="25" FontWeight="SemiBold"/><TextBlock x:Name="PageSubtitle" Text="قیمت لحظه‌ای ارز و طلا در بازار ایران" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel>
      <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="13" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Height="44"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="⌕" FontSize="23" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/><TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" FontFamily="Segoe UI" FontSize="12" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="جستجوی نام یا نماد ارز"/><TextBlock x:Name="SearchHint" Grid.Column="1" Text="جستجوی ارز یا کشور…" Foreground="{StaticResource SubtleBrush}" VerticalAlignment="Center" IsHitTestVisible="False"/></Grid></Border>
     </Grid>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid x:Name="DashboardView" Margin="28,0,28,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid x:Name="PinnedGrid"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions></Grid>
       <Grid x:Name="AnalysisGrid" Grid.Row="1" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{StaticResource CardBrush}" CornerRadius="15" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="20"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="215"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DetailName" Text="دلار آمریکا" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="DetailSymbol" Text="USD / TOMAN" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel><StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock x:Name="DetailPrice" Text="—" FontSize="25" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock x:Name="DetailChange" Text="—" FontSize="11" Foreground="{StaticResource GreenBrush}" HorizontalAlignment="Right"/></StackPanel></Grid>
         <Grid Grid.Row="1" Margin="0,14,0,4"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Border BorderBrush="#222C3C" BorderThickness="0,0,0,1"/><Border Grid.Row="1" BorderBrush="#222C3C" BorderThickness="0,0,0,1"/><Border Grid.Row="2" BorderBrush="#222C3C" BorderThickness="0,0,0,1"/><Canvas x:Name="DetailChart" Grid.RowSpan="4" ClipToBounds="True" SizeChanged="DetailChart_SizeChanged"><Polyline x:Name="DetailLineGlow" Stroke="#332DD4BF" StrokeThickness="8" StrokeLineJoin="Round"/><Polyline x:Name="DetailLine" Stroke="#2DD4BF" StrokeThickness="2.5" StrokeLineJoin="Round"/></Canvas></Grid>
         <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="کمترین امروز" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="LowText" Text="—" FontSize="12" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="بیشترین امروز" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="HighText" Text="—" FontSize="12" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="زمان منبع" Foreground="{StaticResource MutedBrush}" FontSize="10"/><TextBlock x:Name="SourceTimeText" Text="—" FontSize="12" Margin="0,4,0,0"/></StackPanel></Grid>
        </Grid></Border>
        <Border Grid.Column="1" Margin="18,0,0,0" Background="{StaticResource CardBrush}" CornerRadius="16" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions><Grid><TextBlock Text="نمای سریع بازار" FontSize="14" FontWeight="SemiBold"/><Border HorizontalAlignment="Right" Background="#183C39" CornerRadius="8" Padding="8,3"><TextBlock Text="● زنده" Foreground="{StaticResource GreenBrush}" FontSize="9"/></Border></Grid><ItemsControl x:Name="QuickList" Grid.Row="1" Margin="0,13,0,0"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Grid Width="34" Height="34"><Border Background="{Binding IconBackground}" CornerRadius="11"><TextBlock Text="{Binding Icon}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding IconForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Ellipse Width="32" Height="32" Stroke="#374254" StrokeThickness="1"><Ellipse.Fill><ImageBrush ImageSource="{Binding IconPath}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="11"/><TextBlock Text="{Binding Symbol}" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayPrice}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right"/><TextBlock Text="{Binding ChangeText}" FontSize="9" Foreground="{Binding ChangeBrush}" HorizontalAlignment="Right"/></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Grid></Border>
       </Grid>
       <Border Grid.Row="2" Margin="0,18,0,0" Background="{StaticResource CardBrush}" CornerRadius="16" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="18"><StackPanel><Grid Margin="0,0,0,12"><TextBlock Text="ارزهای منتخب" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="برای مشاهده نمودار روی هر ردیف کلیک کنید" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="10"/></Grid>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="9" Padding="10,8" Margin="0,0,0,5"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBlock Grid.Column="1" Text="ارز / کشور" Foreground="{StaticResource SubtleBrush}" FontSize="9"/><TextBlock Grid.Column="2" Text="قیمت" Foreground="{StaticResource SubtleBrush}" FontSize="9"/><TextBlock Grid.Column="3" Text="تغییر" Foreground="{StaticResource SubtleBrush}" FontSize="9"/><TextBlock Grid.Column="4" Text="زمان" Foreground="{StaticResource SubtleBrush}" FontSize="9" HorizontalAlignment="Right"/></Grid></Border>
        <ListView x:Name="MarketList" Background="Transparent" BorderThickness="0" SelectionChanged="MarketList_SelectionChanged" MaxHeight="310" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListViewItem"><Border x:Name="r" CornerRadius="10" Padding="8,9" Background="{TemplateBinding Background}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="r" Property="Background" Value="{StaticResource CardHoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="r" Property="Background" Value="{StaticResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></ListView.ItemContainerStyle><ListView.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="140"/><ColumnDefinition Width="120"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><Grid Width="36" Height="36" HorizontalAlignment="Left"><Border Background="{Binding IconBackground}" CornerRadius="11"><TextBlock Text="{Binding Icon}" FontSize="13" FontWeight="SemiBold" Foreground="{Binding IconForeground}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Ellipse Width="34" Height="34" Stroke="#374254" StrokeThickness="1"><Ellipse.Fill><ImageBrush ImageSource="{Binding IconPath}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse></Grid><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="12"/><TextBlock Text="{Binding Symbol}" Foreground="{StaticResource MutedBrush}" FontSize="9"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding DisplayPrice}" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBlock Grid.Column="3" Text="{Binding ChangeText}" Foreground="{Binding ChangeBrush}" VerticalAlignment="Center"/><TextBlock Grid.Column="4" Text="{Binding TimeText}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate></ListView.ItemTemplate></ListView>
       </StackPanel></Border>
      </Grid>
     </ScrollViewer>
    </Grid>
   </Grid>
  </Grid>
 </Border>
</Window>
